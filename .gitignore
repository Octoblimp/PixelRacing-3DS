# PixelRacing-3DS: the repository holds the port's source, the tools that build
# the RomFS/banner/CIA, and the format notes. Everything else in this folder is
# local working material: the original game files, extracted assets, builds,
# Ghidra exports and session notes.

# ---------------------------------------------------------------- top level
/*
!/.gitignore
!/README.md
!/LICENSE
!/3DS Files/
!/tools/
!/decomp/
!/docs/

# Left out on purpose (covered by /* above):
#   iOS Files & Source/, Wii Files & Source/   original game files (not ours to share)
#   build/, romfs/, out/, scratch_*/           extracted assets, build output, diagnostics
#   Tester Builds/                             CIA/.3dsx/.elf handed to testers (hold game data)
#   TASKS.md, HANDOFF.md, CONTINUE.MD, PORT_PROGRESS.MD, TESTER_NOTES.md
#                                              working notes and tester notes

# ---------------------------------------------------------------- anywhere
.claude/
__pycache__/
*.pyc
*.tmp
*.bak
Thumbs.db
# Ghidra pseudo-C dumps are derived from the original binary: keep them local.
/decomp/raw/
/decomp/raw_wii/
# Third-party binaries copied in from other projects.
/tools/3ds-bin/

# ---------------------------------------------------------------- 3DS Files
# The port's source, headers, Makefile and banner art are committed. Its RomFS holds the
# game's own data (built locally from the user's IPA), and the rest is build output.
/3DS Files/romfs/
/3DS Files/build/
/3DS Files/build_mv/
/3DS Files/*.3dsx
/3DS Files/*.cia
/3DS Files/*.elf
/3DS Files/*.smdh
/3DS Files/*.map
/3DS Files/meta/banner.bnr
/3DS Files/meta/icon.icn
